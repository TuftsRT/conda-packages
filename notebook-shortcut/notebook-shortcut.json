{
  "$schema": "https://schemas.conda.org/menuinst/menuinst-1-1-3.schema.json",
  "menu_name": "{{ DISTRIBUTION_NAME }}",
  "menu_items": [
    {
      "name": {
        "target_environment_is_base": "Jupyter Notebook",
        "target_environment_is_not_base": "Jupyter Notebook ({{ ENV_NAME }})"
      },
      "description": "Launch Jupyter Notebook in your default web browser.",
      "command": [
        "{{ PYTHON }}",
        "-m",
        "notebook",
        "--ServerApp.shutdown_no_activity_timeout=3600"
      ],
      "icon": "{{ MENU_DIR }}/notebook-shortcut.ico",
      "precommand": "@TITLE {{ DISTRIBUTION_NAME }} Jupyter Notebook Server ({{ ENV_NAME }})",
      "activate": true,
      "terminal": true,
      "platforms": {
        "win": {
          "desktop": false,
          "app_user_model_id": "{{ DISTRIBUTION_NAME }}.Jupyter.Notebook.{{ ENV_NAME }}"
        },
        "osx": null,
        "linux": null
      }
    }
  ]
}
