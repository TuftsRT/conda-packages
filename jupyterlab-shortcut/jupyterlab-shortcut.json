{
  "$schema": "https://schemas.conda.org/menuinst/menuinst-1-1-3.schema.json",
  "menu_name": "{{ DISTRIBUTION_NAME }}",
  "menu_items": [
    {
      "name": {
        "target_environment_is_base": "JupyterLab",
        "target_environment_is_not_base": "JupyterLab ({{ ENV_NAME }})"
      },
      "description": "Launch JupyterLab in your default web browser.",
      "command": [
        "{{ PYTHON }}",
        "-m",
        "jupyterlab",
        "--ServerApp.shutdown_no_activity_timeout=3600"
      ],
      "icon": "{{ MENU_DIR }}/jupyterlab-shortcut.ico",
      "precommand": "@TITLE {{ DISTRIBUTION_NAME }} JupyterLab Server ({{ ENV_NAME }})",
      "activate": true,
      "terminal": true,
      "platforms": {
        "win": {
          "desktop": false,
          "app_user_model_id": "{{ DISTRIBUTION_NAME }}.JupyterLab.{{ ENV_NAME }}"
        },
        "osx": null,
        "linux": null
      }
    }
  ]
}
