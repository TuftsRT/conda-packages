{
  "$schema": "https://schemas.conda.org/menuinst-1-1-3.schema.json",
  "menu_name": "{{ DISTRIBUTION_NAME }}",
  "menu_items": [
    {
      "name": {
        "target_environment_is_base": "JupyterLab",
        "target_environment_is_not_base": "JupyterLab ({{ ENV_NAME }})"
      },
      "description": "Launch JupyterLab in your default web browser.",
      "command": ["{{ PYTHONW }}", "-m", "jupyterlab"],
      "icon": "{{ MENU_DIR }}/jupyterlab-shortcut.ico",
      "activate": true,
      "terminal": false,
      "platforms": {
        "win": {
          "desktop": false,
          "app_user_model_id": "{{ DISTRIBUTION_NAME }}.JupyterLab.{{ ENV_NAME }}"
        },
        "osx": null,
        "linux": null
      }
    }
  ]
}
