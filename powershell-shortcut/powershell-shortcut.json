{
  "$schema": "https://schemas.conda.org/menuinst/menuinst-1-1-3.schema.json",
  "menu_name": "{{ DISTRIBUTION_NAME }}",
  "menu_items": [
    {
      "name": {
        "target_environment_is_base": "{{ DISTRIBUTION_NAME }} PowerShell",
        "target_environment_is_not_base": "{{ DISTRIBUTION_NAME }} PowerShell ({{ ENV_NAME }})"
      },
      "description": "Launches PowerShell with conda activated.",
      "command": [
        "%WINDIR%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "-ExecutionPolicy",
        "ByPass",
        "-NoExit",
        "-Command",
        ". '{{ BASE_PREFIX }}\\shell\\condabin\\conda-hook.ps1' ; conda activate '{{ PREFIX }}'"
      ],
      "icon": "{{ MENU_DIR }}/powershell-shortcut.ico",
      "activate": false,
      "platforms": {
        "win": {
          "desktop": false,
          "terminal_profile": "{{ DISTRIBUTION_NAME }} PowerShell ({{ ENV_NAME }})",
          "app_user_model_id": "ConsoleShortcut.PowerShell.{{ DISTRIBUTION_NAME }}.{{ ENV_NAME }}"
        },
        "osx": null,
        "linux": null
      }
    }
  ]
}
